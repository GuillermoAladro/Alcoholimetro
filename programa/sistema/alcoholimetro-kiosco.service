# Pantalla: Chromium a pantalla completa dentro de cage (compositor Wayland de una sola ventana), en tty1,
# sin escritorio. Si Chromium se cierra o se cuelga (el programa lo mata si deja de dar latidos), vuelve solo.
[Unit]
Description=Alcoholimetro - pantalla (Chromium en modo kiosco)
After=alcoholimetro.service systemd-user-sessions.service
Wants=alcoholimetro.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=__USUARIO__
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=WLR_LIBINPUT_NO_DEVICES=1
# espera (máx. 60 s) a que el programa sirva la página
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -fs -o /dev/null http://127.0.0.1:8080/ && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/cage -d -- __CHROMIUM__ --kiosk --incognito --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-features=Translate,TranslateUI,MediaRouter --disable-pinch --overscroll-history-navigation=0 --check-for-update-interval=31536000 --no-first-run --password-store=basic --disk-cache-size=1 --ozone-platform=wayland http://127.0.0.1:8080/
Restart=always
RestartSec=3
MemoryMax=650M

[Install]
WantedBy=multi-user.target
